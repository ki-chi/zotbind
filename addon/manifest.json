{
  "manifest_version": 2,
  "name": "ZotBind",
  "version": "0.1.3",
  "description": "Synchronize a Zotero collection's primary PDFs as safe symbolic links.",
  "author": "Kiichi",
  "icons": {
    "48": "icons/zotbind.svg",
    "96": "icons/zotbind.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotbind@kiichi.dev",
      "strict_min_version": "9.0",
      "strict_max_version": "9.0.*",
      "update_url": "https://raw.githubusercontent.com/kiichi/zotbind/main/updates.json"
    }
  }
}
